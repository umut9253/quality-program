*.jks
*.keystore

# Tablet sunucusu TLS sertifikasi ve OZEL ANAHTARI (app/sunucu.py uretir) - asla depoya girmez
data/tls/
*.key

# Public depo: yerel veri klasörü ve sertifikalar hiç girmez
data/
*.pem
*.crt
