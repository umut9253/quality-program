__pycache__/
*.pyc

# Excel'in açık dosya kilidi (~$Ad.xlsx)
~$*.xlsx

# Yerel yedekler
yedek/

# Tablet sunucusu erişim anahtarı (app/sunucu.py üretir) — gizli
